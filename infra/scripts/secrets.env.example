# Segredos/variáveis das funções (Fase 2).
# 1) Copie este arquivo para secrets.env  (cp secrets.env.example secrets.env)
# 2) Preencha os valores — copie do Netlify → Site configuration → Environment variables
# 3) Rode:  bash infra/scripts/load-secrets.sh
# O secrets.env NÃO é versionado (está no .gitignore). Todos vão para o SSM
# criptografados (SecureString), sob o prefixo /sp-car-clean/.

# ---- IA ----
ANTHROPIC_API_KEY=

# ---- Admin / Site ----
ADMIN_EMAIL=
URL=https://spcarclean.com.br

# ---- Firebase (servidor) ----
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_SECRET=
FIREBASE_API_KEY=
# ATENÇÃO: FCM_SERVICE_ACCOUNT é um JSON grande — NÃO coloque aqui.
# Suba separado, a partir do arquivo JSON, com:
#   aws ssm put-parameter --name /sp-car-clean/FCM_SERVICE_ACCOUNT \
#     --type SecureString --value file://fcm-service-account.json --overwrite

# ---- EmailJS ----
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_BIRTHDAY_TEMPLATE=
EMAILJS_GIFT_TEMPLATE=
EMAILJS_TEMPLATE_UPDATE=
EMAILJS_UPDATE_TEMPLATE=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- WhatsApp ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANG=
WA_TPL_NEW_BOOKING=
WA_TPL_CANCEL=
WA_TPL_PRICE=
WA_TPL_REMINDER=
WA_TPL_RESCHEDULE_APPROVED=
WA_TPL_RESCHEDULE_REJECTED=

# ---- InfinitePay ----
INFINITEPAY_HANDLE=
INFINITEPAY_FEE_RATE=

# ---- Indicações (referral) ----
REFERRAL_FRIEND_PCT=
REFERRAL_REFERRER_PCT=
REFERRAL_VALID_DAYS=
