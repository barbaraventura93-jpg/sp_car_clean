rules_version = '2';

// Firebase Storage — DESATIVADO PARA NOVOS ENVIOS (migrado para o S3).
//
// Fotos e vídeos novos vão para o bucket de mídia na AWS (infra/media.tf, função
// upload-url). Estas regras deixam o Storage SÓ LEITURA durante a transição:
// as URLs antigas continuam abrindo até o scripts/migrate-media.js
// copiar tudo para o S3 e trocar os endereços no Realtime Database.
// Antes, qualquer usuário logado (inclusive cliente) podia gravar aqui.
//
// Publique com `firebase deploy --only storage`. Depois da migração conferida,
// o bucket pode ser apagado no Console (README → "Fotos e vídeos (S3)").
service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /checkin/{allPaths=**} {
      allow read: if request.auth != null;  // o app usa a URL com ?token=, que não depende disto
      allow write: if false;
    }
  }
}
